<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest
	Version="6.0"
	ExtensionBundleId="com.dropplus.panel"
	ExtensionBundleVersion="1.1.3"
	ExtensionBundleName="DROP+"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

	<ExtensionList>
		<Extension Id="com.dropplus.panel" Version="1.1.3" />
	</ExtensionList>

	<ExecutionEnvironment>
		<HostList>
			<Host Name="PPRO" Version="[0.0,99.9]" />
			<Host Name="AEFT" Version="[0.0,99.9]" />
		</HostList>

		<LocaleList>
			<Locale Code="All" />
		</LocaleList>

		<RequiredRuntimeList>
			<RequiredRuntime Name="CSXS" Version="5.0" />
		</RequiredRuntimeList>
	</ExecutionEnvironment>

	<DispatchInfoList>
		<Extension Id="com.dropplus.panel">
			<DispatchInfo>
				<Resources>
					<MainPath>./index.html</MainPath>
					<ScriptPath>./jsx/premiere.jsx</ScriptPath>
					<CEFCommandLine>
						<Parameter>--enable-nodejs</Parameter>
						<Parameter>--mixed-context</Parameter>
						<Parameter>--allow-file-access-from-files</Parameter>
						<Parameter>--allow-file-access</Parameter>
						<Parameter>--enable-features=WebAssemblySimd</Parameter>
						<Parameter>--js-flags=--experimental-wasm-simd</Parameter>
					</CEFCommandLine>
				</Resources>

				<Lifecycle>
					<AutoVisible>true</AutoVisible>
				</Lifecycle>

				<UI>
					<Type>Panel</Type>
					<Menu>DROP+</Menu>
					<Geometry>
						<Size>
							<Height>650</Height>
							<Width>420</Width>
						</Size>
						<MinSize>
							<Height>400</Height>
							<Width>320</Width>
						</MinSize>
						<MaxSize>
							<Height>1400</Height>
							<Width>1000</Width>
						</MaxSize>
					</Geometry>
				</UI>
			</DispatchInfo>
		</Extension>
	</DispatchInfoList>
</ExtensionManifest>
